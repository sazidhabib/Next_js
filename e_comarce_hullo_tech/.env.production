# Application Port
PORT=3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hullotech
Db_port=3306

# Next.js Settings
DISABLE_NEXT=false

# Environment
NODE_ENV=production

# API base path configured for same-origin production deployment
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE_URL=/

# JWT Secret
JWT_SECRET_KEY=MARNPROJECTSECRETKEY
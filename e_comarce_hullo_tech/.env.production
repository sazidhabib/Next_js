# Application Port (cPanel will override this automatically)
PORT=3000

# Database Configuration (MySQL) - Replace with your cPanel MySQL Database credentials
DB_HOST=localhost
DB_USER=replace_with_cpanel_db_user
DB_PASSWORD=replace_with_cpanel_db_password
DB_NAME=replace_with_cpanel_db_name
Db_port=3306

# Next.js Settings
DISABLE_NEXT=false

# Environment
NODE_ENV=production

# Production API URLs for hullotech.com
NEXT_PUBLIC_API_URL=https://hullotech.com/api
NEXT_PUBLIC_API_BASE_URL=https://hullotech.com

# Keep your JWT secret secure
JWT_SECRET_KEY=MARNPROJECTSECRETKEY

# ====================================================================
# Media Uploads Access & Security Policy
# ====================================================================

# 1. Allow public web access to all uploaded media files
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
</IfModule>

# 2. Disable directory listing for privacy
Options -Indexes

# 3. Security: Prevent execution of scripts in uploads folder
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi|sh|bash)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

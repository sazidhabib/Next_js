# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Large binaries & native node addons (Blocks 100MB+ files)
*.node
*.exe
*.dll
*.dylib
*.so
*.wasm
*.zip
*.tar.gz

# Build outputs
dist/
**/dist/
build/
**/build/
.next/
**/.next/
out/
**/out/
.vite/
**/.vite/
.turbo/

# Cache & Testing
/coverage
.cache/
**/.cache/

# Environment files
.env*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System & IDE
.DS_Store
Thumbs.db
.cursor/
.windsurf/
.vscode/

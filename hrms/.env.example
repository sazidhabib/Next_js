# ==========================================
# HRMS Pro - Environment Configuration Example
# Copy this file to .env or .env.local and update values as needed.
# ==========================================

# Database Configuration
# Supported dialects: 'mysql' or 'sqlite'
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hrms_db
DB_USER=root
DB_PASSWORD=

# SQLite Database Storage (used when DB_DIALECT=sqlite or as fallback)
DB_STORAGE=./hrms_database.sqlite

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

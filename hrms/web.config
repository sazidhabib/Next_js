<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- Prevent IIS from swallowing Node.js API error response bodies -->
    <httpErrors existingResponse="PassThrough" />

    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>
    
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
          <add segment=".next" />
          <add segment=".agents" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpPlatform processPath="node" arguments="app.js" startupTimeLimit="60" startupRetryCount="3" stdoutLogEnabled="true" stdoutLogFile="./log.txt">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
